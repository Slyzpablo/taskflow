# =============================================
# TaskFlow Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to GitHub.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local development: use your local PostgreSQL connection string
# Production (Render): paste the Internal Database URL from Render dashboard
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/taskflow_db

